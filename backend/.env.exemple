# ============================================================
# EWA PRINT - ENVIRONNEMENT DE PRODUCTION
# ============================================================
# Instructions :
# 1. Copiez ce fichier en .env
# 2. Remplacez toutes les valeurs entre < > par vos propres valeurs
# 3. Ne partagez jamais votre .env (gardez-le dans .gitignore)
# ============================================================

# ============================================================
# 1. SERVEUR
# ============================================================
# Port sur lequel le backend va tourner
PORT=3000

# ============================================================
# 2. BASE DE DONNÉES (PostgreSQL)
# ============================================================
# URL de connexion à votre base PostgreSQL
# Format: postgresql://<utilisateur>:<mot_de_passe>@<hôte>:<port>/<nom_base>
# Exemple: postgresql://postgres:monmotdepasse@localhost:5432/ewaprint
DATABASE_URL=postgresql://<utilisateur>:<mot_de_passe>@<hôte>:<port>/<nom_base>

# ============================================================
# 3. AUTHENTIFICATION (JWT)
# ============================================================
# Clé secrète pour signer les tokens JWT (minimum 32 caractères)
# Générez une clé aléatoire avec: openssl rand -base64 32
JWT_SECRET=<votre_jwt_secret_minimum_32_caracteres>

# ============================================================
# 4. MODE D'EXÉCUTION
# ============================================================
# production | development
NODE_ENV=production

# ============================================================
# 5. FRONTEND
# ============================================================
# URL de votre frontend (pour les emails de réinitialisation, invitations)
# Exemple: https://mon-entreprise.com ou http://localhost:5173
FRONTEND_URL=<url_de_votre_frontend>

# ============================================================
# 6. CLOUDINARY (Hébergement des images)
# ============================================================
# 1. Créez un compte sur https://cloudinary.com (gratuit)
# 2. Dans le dashboard, récupérez:
#    - Cloud Name (ex: dywspzxiw)
#    - API Key
#    - API Secret
CLOUDINARY_CLOUD_NAME=<votre_cloud_name>
CLOUDINARY_API_KEY=<votre_api_key>
CLOUDINARY_API_SECRET=<votre_api_secret>

# ============================================================
# 7. ENVOI D'EMAILS (BREVO)
# ============================================================
# 1. Créez un compte sur https://www.brevo.com (gratuit - 300 emails/jour)
# 2. Dans le dashboard, allez dans SMTP & API
# 3. Récupérez:
#    - SMTP Login (ex: b4355b001@smtp-brevo.com)
#    - SMTP Password (générez-en un)
# 4. Ajoutez aussi votre email comme expéditeur validé
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=<votre_email_expediteur>  # Ex: contact@monentreprise.com
MAIL_AUTH=<votre_smtp_login>        # Ex: b4355b001@smtp-brevo.com
MAIL_PASS=<votre_smtp_password>     # Ex: xsmtpsib-xxx...

# ============================================================
# 8. RESEND (Alternative email - optionnel)
# ============================================================
# 1. Créez un compte sur https://resend.com
# 2. Générez une clé API
RESEND_API_KEY=<votre_resend_api_key>