// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String   @id
  firstName String?
  lastName  String
  email     String?  @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  orders    Order[]
  invoices  Invoice[]
  quotes    Quote[]
}

model User {
  id        String   @id
  email     String   @unique
  password  String?
  role      String
  isActive  Boolean  @default(false)
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  files     File[]
  payments  Payment[]
  notes     Note[]

  quotesCreated    Quote[]    @relation("UserQuote")
  invoicesCreated  Invoice[]  @relation("UserInvoice")
  ordersCreated    Order[]    @relation("UserOrder")

  resetTokens  PasswordResetToken[]
  invitations  InvitationToken[]
}

enum Role {
  ADMIN
  SALES
  PRINTER
  GRAPHIC_DESIGNER
}

model InvitationToken {
  id        String   @id // UUIDv7
  token     String   @unique // hashed token (security)
  email     String   // invited email
  role      Role     // pre‑assigned role
  expiresAt DateTime // expiration date (e.g. 48h)
  createdAt DateTime @default(now())
  usedAt    DateTime? // marks if already used

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CompanyInfo {
  id                      Int       @id @default(autoincrement())
  nif                     String
  stat                    String
  rif                     String?
  mainAddress             String
  mainAddressDetail       String?
  secondaryAddress        String?
  secondaryAddressDetail  String?
  logo                    String?
  stamp                   String?

  mobileMoneyNumbers      Json?

  standardPhone           String?
  contactEmail            String?

  termsAndConditions      String?
  deliveryLeadTime        String?

  bankAccountHolder       String?
  bankBranch              String?
  bankCode                String?
  ribInfo                 String?

  createdAt               DateTime  @default(now())

  invoices Invoice[]
  quotes   Quote[]
}

model Quote {
  id       Int      @id @default(autoincrement())
  number   String   @unique
  date     DateTime @default(now())
  clientId String
  client   Client   @relation(fields: [clientId], references: [id])

  total  Int
  status String @default("pending")

  companyInfoId Int
  companyInfo   CompanyInfo @relation(fields: [companyInfoId], references: [id])

  // link to the invoice if converted
  transformedToInvoice Invoice? @relation("QuoteToInvoice")

  createdById String
  createdBy   User   @relation("UserQuote", fields: [createdById], references: [id])

  // all orders of this quote
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id       Int      @id @default(autoincrement())
  number   String   @unique
  date     DateTime @default(now())
  clientId String
  client   Client   @relation(fields: [clientId], references: [id])

  total     Int
  deposit   Int @default(0)
  remaining Int

  deliveryPlace       String?
  expectedDeliveryDate DateTime?

  isDelivered      Boolean @default(false)
  paymentStatus    String  @default("unpaid")

  companyInfoId Int
  companyInfo   CompanyInfo @relation(fields: [companyInfoId], references: [id])

  // link to the original quote (if this invoice comes from a quote)
  originalQuoteId Int?   @unique
  originalQuote   Quote? @relation("QuoteToInvoice", fields: [originalQuoteId], references: [id])

  createdById String
  createdBy   User @relation("UserInvoice", fields: [createdById], references: [id])

  // all orders of this invoice
  orders Order[]

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model File {
  id   String @id
  url  String
  name String
  type String

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  uploadedById String
  uploadedBy   User @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}

model Payment {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  amount Int

  method    String
  reference String?

  date DateTime @default(now())

  receivedById String
  receivedBy   User @relation(fields: [receivedById], references: [id])
}

model Note {
  id    Int    @id @default(autoincrement())
  text  String

  userId String
  user   User @relation(fields: [userId], references: [id])

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
}

model AppSettings {
  id                Int      @id @default(1)
  maxRegistrations  Int      @default(10)
  registrationsOpen Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model Order {
  id          Int    @id @default(autoincrement())
  reference   String @unique
  designation String

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  quoteId   Int?
  invoiceId Int?

  quote   Quote?   @relation(fields: [quoteId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  // chosen variant (e.g. Pre-cut vinyl)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  options Json? // e.g. { "format": "A4", "doubleSided": false }

  pricingRuleId String
  pricingRule   PricingRule @relation(fields: [pricingRuleId], references: [id])

  widthCm  Float?
  heightCm Float?

  status   String @default("waiting_for_file")
  quantity Int
  unitPrice Int
  totalPrice Int // total price of the order line at creation time

  createdById String
  createdBy   User @relation("UserOrder", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  files File[]
  notes Note[]
}

model Product {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  category  String?  // "print", "signage", "textile", etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   // "Pre-cut", "Without cut", "Recto", "Recto verso", "Standard", "Luxury"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  pricingRules PricingRule[]
}

model PricingRule {
  id          String      @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  pricingMode PricingMode
  label       String?     // "Price per m²", "Price per A4", "Standard price", etc.
  config      Json        // Structure validated by Zod according to pricingMode
  priority    Int         @default(0) // display order
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orders Order[]
  @@index([variantId])
}

enum PricingMode {
  FIXED           // fixed price (mug, t‑shirt)
  PER_M2          // price per square meter (banner, vinyl without cut)
  PER_UNIT        // price per unit (business card)
  FORMAT          // price by format (PVC: A4, A3, A2...)
  RECTO_VERSO     // recto / recto‑verso (flyers)
  PER_METER       // price per linear meter (flag)
  OPTION          // extra (grommet, lamination, installation)
  COMPOSITE       // combination of several rules (pre‑cut: m² + A4)
}

model Format {
  id        String   @id @default(cuid())
  name      String   @unique // "A4", "A3", "A2", "A1", "A0"
  widthMm   Int      // width in mm
  heightMm  Int      // height in mm
  createdAt DateTime @default(now())
}

// Workshop configuration (only one active row)
model WorkshopConfig {
  id              String @id @default(cuid())
  maxWidthM       Float  @default(1.5)
  cuttingMarginM  Float  @default(0.02)
  referenceSurfaceM2 Json @default("{\"width\":1.5,\"height\":0.7}")
  isActive        Boolean @default(true)
}