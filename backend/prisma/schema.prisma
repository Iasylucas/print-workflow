// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String   @id
  firstName String
  lastName  String?
  email     String?  @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  orders    Order[]
  invoices  Invoice[]
  quotes    Quote[]
}

model User {
  id        String   @id
  avatarUrl String?
  email     String   @unique
  password  String?
  role      String
  isActive  Boolean  @default(false)
  firstName String?
  lastName  String?
  phone    String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  files     File[]
  payments  Payment[]
  notes     Note[]

  quotesCreated    Quote[]    @relation("UserQuote")
  invoicesCreated  Invoice[]  @relation("UserInvoice")
  ordersCreated    Order[]    @relation("UserOrder")

  resetTokens  PasswordResetToken[]
  resetEmailRequest EmailChangeRequest[]
}

enum Role {
  ADMIN
  SALES
  PRINTER
  GRAPHIC_DESIGNER
}

model InvitationToken {
  id        String   @id // UUIDv7
  token     String   @unique // hashed token (security)
  email     String   // invited email
  role      Role     // pre‑assigned role
  expiresAt DateTime // expiration date (e.g. 48h)
  createdAt DateTime @default(now())
  usedAt    DateTime? // marks if already used
}

model EmailChangeRequest {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}
model PasswordResetToken {
  id        String   @id
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt       DateTime?

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CompanyInfo {
  id                      Int       @id @default(autoincrement())
  nif                     String
  stat                    String
  rif                     String?
  mainAddress             String
  mainAddressDetail       String?
  secondaryAddress        String?
  secondaryAddressDetail  String?
  logo                    String?
  name                    String    @default("Ewa print")
  stamp                   String?

  mobileMoneyNumbers      Json?

  standardPhone           String?
  contactEmail            String?

  termsAndConditions      String?
  deliveryLeadTime        String?

  bankAccountHolder       String?
  bankBranch              String?
  bankCode                String?
  ribInfo                 String?

  createdAt               DateTime  @default(now())

  invoices Invoice[]
  quotes   Quote[]
}

model Quote {
  id       Int      @id @default(autoincrement())
  number   String   @unique
  date     DateTime @default(now())
  clientId String
  client   Client   @relation(fields: [clientId], references: [id])

  total  Int
  status String @default("pending")

  companyInfoId Int
  companyInfo   CompanyInfo @relation(fields: [companyInfoId], references: [id])


  createdById String
  createdBy   User   @relation("UserQuote", fields: [createdById], references: [id])

  // all orders of this quote
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([createdAt])
}

model Invoice {
  id       Int      @id @default(autoincrement())
  number   String   @unique
  date     DateTime @default(now())
  clientId String
  client   Client   @relation(fields: [clientId], references: [id])

  total     Int
  deposit   Int @default(0)
  // remaining Int

  deliveryPlace       String?
  expectedDeliveryDate DateTime?

  isDelivered      Boolean @default(false)
  paymentStatus    String  @default("unpaid")

  companyInfoId Int
  companyInfo   CompanyInfo @relation(fields: [companyInfoId], references: [id])

  // link to the original quote (if this invoice comes from a quote)
  originalQuoteId Int?   @unique

  createdById String
  createdBy   User @relation("UserInvoice", fields: [createdById], references: [id])

  // all orders of this invoice
  orders Order[]

  payments Payment[]
  deletedAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model File {
  id   Int      @id @default(autoincrement())
  url  String
  category String

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  uploadedById String
  uploadedBy   User @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}

model Payment {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  amount Int

  method    String
  reference String?

  date DateTime @default(now())

  receivedById String
  receivedBy   User @relation(fields: [receivedById], references: [id])
}

model Note {
  id    Int    @id @default(autoincrement())
  text  String

  userId String
  user   User @relation(fields: [userId], references: [id])

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
}

model AppSettings {
  id                Int      @id @default(1)
  maxRegistrations  Int      @default(10)
  registrationsOpen Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model Order {
  id          Int      @id @default(autoincrement())
  reference   String   @unique 
  designation String
  label       String? 
  dimensions  String? 

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  productId   Int?            // ← optionnel (si le produit existe dans le catalogue)
  product     Product?        @relation(fields: [productId], references: [id])

  unitPrice  Int
  quantity   Int

  status String @default("waiting_for_file")
  files File[]
  notes Note[]

  invoiceId Int?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  quoteId   Int?
  quote     Quote?   @relation(fields: [quoteId], references: [id])

  // 👇 Audit
  createdById String
  createdBy   User @relation("UserOrder", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([createdAt])
}

model Product {
  id        Int   @id @default(autoincrement())
  name      String
  slug      String  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[] 
  variants  ProductVariant[]
}


model ProductVariant {
  id        Int   @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   // "Prédécoupé", "Sans découpe", "Recto Verso"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingRules PricingRule[]
}


model PricingRule {
  id          Int      @id @default(autoincrement())
  variantId   Int
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  pricingMode PricingMode // L'enum (PER_M2, FORMAT, PER_UNIT, etc.)
  config      Json        // Votre structure flexible validée par Zod
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([variantId])
}



enum PricingMode {
  FIXED           // fixed price (mug, t‑shirt)
  PER_M2          // price per square meter (banner, vinyl without cut)
  PER_UNIT        // price per unit (business card)
  FORMAT          // price by format (PVC: A4, A3, A2...)
  RECTO_VERSO     // recto / recto‑verso (flyers)
  PER_METER       // price per linear meter (flag)
  OPTION          // extra (grommet, lamination, installation)
  COMPOSITE       // combination of several rules (pre‑cut: m² + A4)
}


